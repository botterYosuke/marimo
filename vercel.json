{
  "buildCommand": "bash scripts/build-docs.sh",
  "outputDirectory": "site",
  "installCommand": "echo 'skip npm install'",
  "framework": null,
  "redirects": [
    { "source": "/:path*.html", "destination": "/:path*/", "permanent": true },
    { "source": "/:path([^.]*[^/]$)", "destination": "/:path/", "permanent": true }
  ]
}
