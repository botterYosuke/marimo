{
  "identifier": "default",
  "description": "Default capabilities for marimo desktop",
  "windows": ["main", "notebook-*", "home-*"],
  "permissions": [
    "core:default",
    "shell:allow-execute",
    "shell:allow-open",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file"
  ]
}
